def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    if argv[:1] == ['_acp-code']:
        from acp import code as acp_code
        return acp_code(argv[1], argv[2:])
    # Native Dock/Finder launches bypass the CLI. Prepare configuration without running
    # storage migration, which can itself rebuild an app during startup.
    if argv[:1] == ['_prepare-skills']:
        if len(argv) != 2:
            raise ValueError('Invalid Desktop skill preparation invocation.')
        _, profile = get_profile(argv[1])
        return prepare_profile(profile)
    # Desktop entries use this internal foreground runner; keep it out of user help.
    if argv[:1] == ['_desktop-run']:
        if not LINUX or len(argv) != 2:
            raise ValueError('Invalid Linux desktop launcher invocation.')
        ensure_storage()
        import linux_desktop
        key, profile = get_profile(argv[1])
        return linux_desktop.launch(sys.modules[__name__], key, profile)
    if argv[:1] == ['_global-status']:
        from global_code import status_line
        return status_line(sys.modules[__name__], *argv[1:])
    if argv[:1] == ['_global-selection']:
        # Older running sessions still call this hook with routing-only model IDs.
        from global_code import json_object
        model = json_object(sys.stdin.read()).get('requested_model')
        if isinstance(model, str) and re.fullmatch(r'manyclaude-route-[0-9]+', model):
            print('Restart glaude to use the updated picker. This session is still open.', file=sys.stderr)
            raise SystemExit(2)
        return
    if argv[:1] == ['global']:
        from global_code import launch
        if argv[1:] not in (['--help'], ['-h']):
            ensure_storage()
        return launch(sys.modules[__name__], argv[1:])
    if argv[:1] == ['custom-run']:
        if len(argv) < 2:
            raise ValueError('Expected manyclaude custom-run <custom profile> [arguments].')
