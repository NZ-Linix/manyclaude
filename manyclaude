    sync_aliases(profiles)


def running(profile):
    if LINUX:
        from linux_desktop import running as linux_running
        return linux_running(profile)
    if profile.get('regular'):
        executable = str(Path(profile['app']) / 'Contents/MacOS/')
        result = subprocess.run(['/bin/ps', '-ax', '-o', 'command='], capture_output=True, text=True, check=True)
        return any(line.startswith(executable) and '--type=' not in line and '--user-data-dir=' not in line
                   for line in result.stdout.splitlines())
    path = Path(profile["desktop"]).parent / "desktop.lock"
    if not path.exists():
        return False
    with path.open("a+") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return False
        except BlockingIOError:
            return True


def reset_paths(key, profile):
    if profile.get('regular'):
        home = Path.home()
        paths = [home / 'Library/Application Support/Claude', home / 'Library/Application Support/Claude-3p',
                 home / '.claude', home / '.claude.json', home / 'Library/Logs/Claude',
                 home / 'Library/Logs/Claude-3p', home / 'Library/Caches/com.anthropic.claudefordesktop',
                 home / 'Library/Preferences/com.anthropic.claudefordesktop.plist',
                 home / 'Library/Saved Application State/com.anthropic.claudefordesktop.savedState']
        if LINUX:
            from linux_desktop import xdg_directory
            paths = [regular_desktop_data(), home / '.claude', home / '.claude.json',
                     xdg_directory('XDG_CACHE_HOME', '.cache') / 'Claude']
        paths += list(home.glob('.claude.json.backup*'))
        if profile['code'] != str(home / '.claude') or profile['desktop'] != str(paths[0]):
            raise ValueError('Regular profile has unexpected data paths. Refusing to reset.')
        return paths
    from storage import profile_dir
    directory = profile_dir(key)
    if profile['code'] != str(directory) or profile['desktop'] != str(directory / 'desktop'):
        raise ValueError('Profile has unexpected data paths. Refusing to reset.')
    if any(Path(profile[field]).is_symlink() for field in ('code', 'desktop')):
        raise ValueError('Refusing to reset redirected profile data folders.')
    from storage import safe_path
    safe_path(directory)
    backup = Path.home() / '.manyclaude-storage-backup' / key
    safe_path(backup)
    return [directory, backup] if backup.exists() else [directory]


def reset_data(name):
    key, profile = get_profile(name)
    paths = reset_paths(key, profile)
    if profile.get('regular'):
        if LINUX and any(running(p) for p in read_profiles().values()):
            raise ValueError('Quit all Claude Desktop instances before resetting the regular profile.')
        executables = {str(Path(p['app']) / 'Contents/MacOS/') for p in read_profiles().values()}
        result = subprocess.run(['/bin/ps', '-ax', '-o', 'uid=,command='], capture_output=True, text=True, check=True)
        commands = [parts[1] for line in result.stdout.splitlines()
                    if len(parts := line.strip().split(None, 1)) == 2 and parts[0] == str(os.getuid())]
        if any(any(line.startswith(executable) for executable in executables) and '--type=' not in line for line in commands):
            raise ValueError('Quit all Claude Desktop instances before resetting the regular profile.')
        if any(re.search(r'(?:^|/)claude(?:\s|$)|/claude/versions/|@anthropic-ai/claude-code/', line) for line in commands):
            raise ValueError('Quit all Claude Code sessions before resetting the regular profile.')
    elif running(profile):
        raise ValueError('Quit this profile’s Claude Desktop before resetting it.')
    # Prevent a redirected parent folder from turning reset into deletion outside its intended root.
    root = Path.home().resolve()
    unresolved_root = Path.home()
    for path in paths:
        if LINUX and profile.get('regular'):
            from linux_desktop import xdg_directory
            roots = [Path.home(), xdg_directory('XDG_CONFIG_HOME', '.config'), xdg_directory('XDG_CACHE_HOME', '.cache')]
            parent = next((r for r in roots if path.is_relative_to(r)), None)
            if parent is None or parent.is_symlink():
                raise ValueError(f'Refusing to clear a redirected data path: {path}')
            expected = parent.resolve() / path.relative_to(parent)
        else:
            expected = root / path.relative_to(unresolved_root)
        if path.is_symlink() or path.resolve() != expected:
            raise ValueError(f'Refusing to clear a redirected data path: {path}')
    service = 'Claude Code-credentials'
    if not profile.get('regular'):
        service += '-' + hashlib.sha256(unicodedata.normalize('NFC', profile['code']).encode()).hexdigest()[:8]
    if (BASE / 'openusage-enabled').exists():
        sync_openusage(exclude=(key,))
    from profile_config import forget_profile
    forget_profile(sys.modules[__name__], key)
    if not LINUX:
        result = subprocess.run(['/usr/bin/security', 'delete-generic-password', '-s', service], capture_output=True, text=True)
        if result.returncode not in (0, 44):
            raise ValueError('Could not remove Code Keychain credentials: ' + result.stderr.strip())
    for path in paths:
        if path.is_dir():
            shutil.rmtree(path)
        elif path.exists():
            path.unlink()
    if not profile.get('regular'):
        for path in (Path(profile['desktop']), Path(profile['code'])):
            path.mkdir(parents=True, exist_ok=True, mode=0o700)
    print(f"Reset {profile['name']}. App and command kept; local logins, settings, and history cleared.")


def remove(name, purge=False):
    key, profile = get_profile(name)
    if profile.get('regular'):
        if purge:
            reset_data(name)
        profiles = read_profiles()
        if (BASE / 'openusage-enabled').exists():
            sync_openusage(exclude=(key,))
            profiles = read_profiles()
        del profiles[key]
        sync_aliases(profiles, [profile['rc']] if profile.get('rc') else [])
        save_profiles(profiles)
        print(f"Unregistered {profile['name']}. The regular Claude app and command are still installed.")
        return
    if running(profile):
        raise ValueError("Quit this profile's Claude Desktop before removing it.")
    profiles = read_profiles()
    del profiles[key]
    app = Path(profile["app"])
    if app.exists() or app.is_symlink():
        if LINUX:
            from linux_desktop import owned
            owned(sys.modules[__name__], key, app)
        else:
            info = plistlib.loads((app / "Contents/Info.plist").read_bytes())
            if info.get("ManyClaudeProfile") != str(BASE / "profiles" / key):
                raise ValueError(f"Refusing to remove an app not owned by this profile: {app}")
    from storage import profile_dir
    directory = profile_dir(key)
    extra_rc = [profile['rc']] if profile.get('rc') else []
    sync_aliases(profiles, extra_rc, dry_run=True)
    if (BASE / 'openusage-enabled').exists():
        sync_openusage(exclude=(key,))
        profiles = read_profiles()
        del profiles[key]
    if purge:
        if directory.is_symlink() or directory.resolve() != (Path.home().resolve() / directory.name):
            raise ValueError('Refusing to delete a profile folder redirected outside ManyClaude.')
        data_paths = reset_paths(key, profile)
        # Login tokens on macOS live in a profile-specific Keychain service.
        if not LINUX:
            digest = hashlib.sha256(unicodedata.normalize('NFC', profile['code']).encode()).hexdigest()[:8]
            result = subprocess.run(['/usr/bin/security', 'delete-generic-password', '-s',
                                     'Claude Code-credentials-' + digest], capture_output=True, text=True)
            if result.returncode not in (0, 44):  # errSecItemNotFound is harmless for a never-used profile.
                raise ValueError('Could not remove the profile Keychain credential: ' + result.stderr.strip())
    sync_aliases(profiles, extra_rc)
    if app.exists():
        if LINUX:
            app.unlink()
            from linux_desktop import refresh_database
            refresh_database(app.parent)
        else:
            shutil.rmtree(app)
    if purge:
        for path in data_paths:
            if path.exists():
                shutil.rmtree(path)
        save_profiles(profiles)
        print(f"Removed {profile['name']}'s app, alias, and profile data.")
    else:
        save_profiles(profiles)
        print(f"Removed {profile['name']}'s app and alias. Login/settings data kept at {directory}")


