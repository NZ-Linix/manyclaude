    global_alias = commands.add_parser('global-alias', help='install or rename the global Claude Code command')
    global_alias.add_argument('name', nargs='?', help='executable name (default: claude-global)')
    global_alias.add_argument('--disable', action='store_true', help='remove the global executable')
    custom = commands.add_parser('custom', help='manage custom Global Claude Code profiles')
    custom_actions = custom.add_subparsers(dest='custom_action')
    custom_actions.add_parser('list', help='list custom profiles and prompt folders')
    custom_set = custom_actions.add_parser('set', help='create or update a custom profile')
    custom_set.add_argument('name')
    custom_set.add_argument('--command', dest='custom_command', help='executable name (default: the profile slug)')
    custom_set.add_argument('--env', action='append', help='KEY=VALUE; repeat for multiple; replaces saved variables')
    custom_set.add_argument('--clear-env', action='store_true', help='clear saved environment variables')
    custom_set.add_argument('--flags', help='quoted Claude Code flags; <MANYCLAUDE_PROMPT> opens the prompt picker')
    custom_set.add_argument('--store', choices=('global', 'separate'),
                            help='share settings/history with Global (default) or keep them separate')
    custom_actions.add_parser('remove', help='remove a custom profile and its command').add_argument('name')
    exporter = commands.add_parser('export', help='list conversations or export one to a .jsonl file')
    exporter.add_argument('source', nargs='?',
                          help="profile name, 'global', or 'custom:<name>' (omit to choose in a TUI)")
    exporter.add_argument('session', nargs='?', help='session ID, unique ID prefix, or latest (this folder)')
    exporter.add_argument('output', nargs='?', help='destination .jsonl file or folder (default: current folder)')
    exporter.add_argument('--id', dest='session_id', metavar='ID',
                          help='export this session ID (or unique prefix) from any store: export --id ID [OUTPUT]')
    exporter.add_argument('--all', action='store_true', help='list conversations from every project folder')
    exporter.add_argument('--force', action='store_true', help='replace an existing output file')
    folders = commands.add_parser('prompt-folders', help='folders whose .md files appear in the prompt picker')
    folders.add_argument('--add', action='append', metavar='FOLDER')
    folders.add_argument('--remove', action='append', metavar='FOLDER')
    args = parser.parse_args(argv)
    if sys.platform != "darwin" and not LINUX:
        raise ValueError("manyclaude supports macOS and Linux.")
    ensure_storage(check=args.command == "migrate" and args.check)
    if args.command == "migrate":
        return
    if args.command is None:
        return wizard()
    destructive = args.command == 'reset' or (args.command == 'remove' and args.purge)
    if destructive and not args.yes:
        key, profile = get_profile(args.name)
        print(f"Permanently clear {profile['name']}'s stored logins, settings, and history. Quit its Code sessions first.")
        for path in reset_paths(key, profile):
            print('  ' + str(path))
        print('The regular app/command stay installed.' if profile.get('regular') or args.command == 'reset'
              else 'The profile app and alias will also be removed.')
        if not sys.stdin.isatty():
            raise ValueError('Permanent deletion requires confirmation. Pass --yes to confirm.')
        if input(f"Type {profile['name']} to confirm: ") != profile['name']:
            print('Cancelled. Nothing removed.')
            return
    if args.command in ("create", "refresh", "remove", "alias", 'reset', 'openusage', 'code-options',
                        'update-claude', 'sync-config', 'global-alias', 'custom', 'prompt-folders'):
        BASE.mkdir(parents=True, exist_ok=True, mode=0o700)
        with (BASE / ".manager.lock").open("a+") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            if args.command in ('custom', 'prompt-folders'):
                import custom_profiles
                manager = sys.modules[__name__]
                if args.command == 'prompt-folders':
                    return custom_profiles.configure_folders(manager, args.add, args.remove)
                if args.custom_action == 'set':
                    return custom_profiles.configure(manager, args.name, command=args.custom_command, env=args.env,
                                                     clear_env=args.clear_env, flags=args.flags, store=args.store)
                if args.custom_action == 'remove':
                    return custom_profiles.remove(manager, args.name)
                return custom_profiles.listing(manager)
            if args.command == 'global-alias':
                from global_code import configure_launcher
                return configure_launcher(sys.modules[__name__], args.name, args.disable)
            if args.command == 'update-claude':
                import updater
                return updater.update(sys.modules[__name__], yes=args.yes)
            if args.command == 'openusage':
                return sync_openusage(enable=not args.disable, disable=args.disable)
            if args.command == 'sync-config':
                return sync_config(args.sync_action)
            if args.command == 'code-options':
                return code_options(args.name, [] if args.clear_env else args.env, args.flags, args.from_alias,
                                    args.rc, args.clear, args.trust_folders, args.allow_external_imports)
            if args.command == "create":
                return add(args)
            if args.command == "refresh":
                return refresh(args.name)
            if args.command == 'alias':
                return rename_alias(args.name, args.new_alias)
            if args.command == 'reset':
                return reset_data(args.name)
            return remove(args.name, args.purge)
    if args.command == "list":
        return listing()
    if args.command == 'export':
        import convo_export
        return convo_export.command(sys.modules[__name__], args.source, args.session, args.output,
                                    args.all, args.force, args.session_id)
    if args.command == "open":
        return desktop(args.name)
    if args.command == "code":
        arguments = args.arguments[1:] if args.arguments[:1] == ["--"] else args.arguments
        return code_command(args.name, arguments)


if __name__ == "__main__":
    try:
        main()
    except (KeyboardInterrupt, EOFError):
        print("\nCancelled.", file=sys.stderr)
        sys.exit(130)
    except (ValueError, OSError, subprocess.CalledProcessError) as error:
        print(f"manyclaude: {error}", file=sys.stderr)
        sys.exit(1)
